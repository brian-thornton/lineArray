# Copy to .env and edit. docker compose reads .env automatically.

# Folder containing your music on the host. It's mounted into the container at
# the same path, so the library index stays valid across host and container.
MUSIC_PATH=/path/to/your/music

# LAN address (host:port) phones should use — shown in the app's QR code.
# Leave empty if you always browse to the jukebox by its LAN address.
PUBLIC_HOST=
